{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer-when-downgrade"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-src 'self' https://vidsrc.me https://*.vidsrc.*;"
        }
      ]
    }
  ]
}
